        </visual>
        <!-- Pared intermedia: Y=5.74 a 8.00. -->
        <collision name="pared_intermedia_collision">
          <pose>-1.14 6.87 1.60 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 2.26 3.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="pared_intermedia_visual">
