          <geometry>
            <box>
              <size>2.72 1.78 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <!-- Piso de la zona inferior en U y union con el pasillo. -->
        <collision name="piso_zona_inferior_collision">
          <pose>-2.975 26.355 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>5.85 6.91 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="piso_zona_inferior_visual">
