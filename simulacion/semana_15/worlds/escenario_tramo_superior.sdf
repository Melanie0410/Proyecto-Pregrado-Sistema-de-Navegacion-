    </model>
    <!-- =====================================================
         SECCION 04 - PAREDES DEL TRAMO INICIAL
         Longitud interior: 4.49 m.
         Ancho interior: 2.39 m.
         ===================================================== -->
    <model name="pared_extremo_superior">
      <static>true</static>
      <pose>1.195 -0.14 1.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.95 0.28 3.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.95 0.28 3.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.78 0.72 1</ambient>
            <diffuse>0.80 0.78 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pared_izquierda">
      <static>true</static>
      <pose>-0.14 2.245 1.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.28 4.49 3.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.28 4.49 3.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.78 0.72 1</ambient>
            <diffuse>0.80 0.78 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- =====================================================
         SECCION 05 - ENSANCHAMIENTO Y DOS PUERTAS

         Secuencia longitudinal:
         pared 0.25 + puerta 1.00 + pared 2.26
         + puerta 1.00 + pared 0.25 = 4.76 m.
         ===================================================== -->
    <model name="pared_ensanchamiento">
      <static>true</static>
      <pose>-0.64 4.35 1.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.72 0.28 3.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
