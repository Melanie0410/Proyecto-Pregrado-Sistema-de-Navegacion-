<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <!--
  ESCENARIO MEDIDO - SEMANA 15 - G1 EDU

  Buscar con Ctrl+F:
    SECCION 01: sistemas
    SECCION 02: iluminacion
    SECCION 03: suelo
    SECCION 04: paredes iniciales
    SECCION 05: ensanchamiento y puertas
    SECCION 06: retorno y pared larga
    SECCION 07: columnas y muretes
    SECCION 08: interfaz y camara

  UNIDADES:
    Metros y radianes.
    size = X Y Z
    pose = X Y Z giro_X giro_Y giro_Z

  REFERENCIAS:
    El pasillo continua hacia +Y.
    La superficie del piso esta en Z=0.
    La pared inicial tiene su cara interior en X=0.
    El lateral derecho tiene su cara interior en X=2.39.

  RECORRIDO:
    Tramo inicial:      Y=0.00 a 4.49
    Seccion puertas:    Y=4.49 a 9.25
    Retorno:            Y=9.25 a 9.53
    Nueva pared larga:  Y=9.53 a 16.98

    Retorno + pared larga = 0.28 + 7.45 = 7.73 m.

  PROVISIONALES:
    Altura de puertas: 2.00 m.
    Espesor de puertas: 0.04 m.
    Espesor del piso: 0.10 m.

  El escenario sigue en construccion.
  El lateral de columnas conserva solamente las piezas ya creadas.
  -->
  <world name="tramo_superior">
    <!-- =====================================================
         SECCION 01 - SISTEMAS DE SIMULACION
         ===================================================== -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- =====================================================
         SECCION 02 - ILUMINACION
         ===================================================== -->
    <light name="sol" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- =====================================================
         SECCION 03 - SUELO
         Un solo modelo con varias cajas.
         Todas las superficies superiores quedan en Z=0.
         ===================================================== -->
    <model name="suelo">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <!-- Piso inicial: incluye la base de la pared del fondo. -->
        <collision name="principal_collision">
          <pose>1.195 2.105 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>2.95 4.77 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="principal_visual">
          <pose>1.195 2.105 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>2.95 4.77 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <!-- Base del primer ensanchamiento. -->
        <collision name="esquina_collision">
          <pose>-0.64 4.35 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.72 0.28 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="esquina_visual">
          <pose>-0.64 4.35 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.72 0.28 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <!-- Base de la union exterior de la primera esquina. -->
        <collision name="union_exterior_collision">
          <pose>-1.14 4.35 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 0.28 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="union_exterior_visual">
          <pose>-1.14 4.35 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 0.28 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <!-- Piso de la seccion con puertas: Y=4.49 a 9.25. -->
        <collision name="seccion_puertas_collision">
          <pose>0.695 6.87 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.95 4.76 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="seccion_puertas_visual">
          <pose>0.695 6.87 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.95 4.76 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <!-- Piso del retorno y paso contiguo: Y=9.25 a 9.53. -->
        <collision name="retorno_collision">
          <pose>0.695 9.39 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.95 0.28 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="retorno_visual">
          <pose>0.695 9.39 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.95 0.28 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <!-- Piso del tramo largo: Y=9.53 a 16.98. -->
        <collision name="tramo_largo_collision">
          <pose>1.17 13.255 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.00 7.45 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="tramo_largo_visual">
          <pose>1.17 13.255 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.00 7.45 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- =====================================================
         SECCION 04 - PAREDES DEL TRAMO INICIAL
         Longitud interior: 4.49 m.
         Ancho interior: 2.39 m.
         ===================================================== -->
    <model name="pared_extremo_superior">
      <static>true</static>
      <pose>1.195 -0.14 1.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.95 0.28 3.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.95 0.28 3.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.78 0.72 1</ambient>
            <diffuse>0.80 0.78 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="pared_izquierda">
      <static>true</static>
      <pose>-0.14 2.245 1.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.28 4.49 3.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.28 4.49 3.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.78 0.72 1</ambient>
            <diffuse>0.80 0.78 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- =====================================================
         SECCION 05 - ENSANCHAMIENTO Y DOS PUERTAS

         Secuencia longitudinal:
         pared 0.25 + puerta 1.00 + pared 2.26
         + puerta 1.00 + pared 0.25 = 4.76 m.
         ===================================================== -->
    <model name="pared_ensanchamiento">
      <static>true</static>
      <pose>-0.64 4.35 1.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.72 0.28 3.20</size>
            </box>
