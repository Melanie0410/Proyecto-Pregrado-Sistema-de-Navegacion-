          <geometry>
            <box>
              <size>5.57 0.28 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="piso_union_zona_inferior_visual">
          <pose>-3.115 22.76 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>5.57 0.28 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <!-- Piso del pasillo y bases junto a las escaleras. -->
        <collision name="pasillo_junto_escaleras_collision">
          <pose>1.17 24.16 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>2.44 2.52 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="pasillo_junto_escaleras_visual">
          <pose>1.17 24.16 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>2.44 2.52 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <collision name="base_refuerzo_escaleras_collision">
          <pose>2.81 20.98 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 0.28 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_refuerzo_escaleras_visual">
          <pose>2.81 20.98 -0.05 0 0 0</pose>
          <geometry>
            <box>
