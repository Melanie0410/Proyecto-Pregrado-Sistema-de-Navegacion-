        </collision>
        <visual name="puerta_2_visual">
          <pose>-1.02 8.50 1.00 0 0 0</pose>
          <geometry>
            <box>
              <size>0.04 1.00 2.00</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.45 0.55 1</ambient>
            <diffuse>0.35 0.45 0.55 1</diffuse>
          </material>
        </visual>
        <!-- Pared sobre puerta 2: Z=2.00 a 3.20. -->
        <collision name="sobre_puerta_2_collision">
          <pose>-1.14 8.50 2.60 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 1.00 1.20</size>
