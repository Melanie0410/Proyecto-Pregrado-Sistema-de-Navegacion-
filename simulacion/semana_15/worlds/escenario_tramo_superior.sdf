          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <collision name="continuacion_derecha_collision">
          <pose>1.17 19.05 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.00 4.14 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="continuacion_derecha_visual">
          <pose>1.17 19.05 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.00 4.14 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <collision name="continuacion_izquierda_collision">
          <pose>1.03 22.01 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>2.72 1.78 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="continuacion_izquierda_visual">
