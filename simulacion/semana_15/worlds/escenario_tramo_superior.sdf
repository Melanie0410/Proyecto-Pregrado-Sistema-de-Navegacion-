          <pose>-1.14 4.615 1.60 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 0.25 3.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="pared_inicial_visual">
          <pose>-1.14 4.615 1.60 0 0 0</pose>
          <geometry>
            <box>
