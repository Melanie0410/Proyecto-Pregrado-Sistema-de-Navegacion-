              <size>0.72 0.28 3.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.78 0.72 1</ambient>
            <diffuse>0.80 0.78 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="seccion_puertas">
      <static>true</static>
      <link name="link">
