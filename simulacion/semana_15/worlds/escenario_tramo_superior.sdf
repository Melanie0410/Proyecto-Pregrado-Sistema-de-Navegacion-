            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
        <!-- Piso plano de 0.56 m antes de ambos tramos de escaleras. -->
        <collision name="piso_previo_escalera_subida_collision">
          <pose>2.67 22.285 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.56 2.33 0.10</size>
            </box>
          </geometry>
        </collision>
        <visual name="piso_previo_escalera_subida_visual">
          <pose>2.67 22.285 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.56 2.33 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.52 0.47 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
